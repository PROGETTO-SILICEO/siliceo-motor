.version 8.4
.target sm_86
.address_size 64

//
// SMOKE TEST — scaffolding scritto a mano in PTX.
//
// Scopo: validare l'intera catena driver→modulo→launch→copy-back su
// hardware reale PRIMA di montare la pipeline Rust->PTX (cuda_builder,
// nightly pinnato) che sostituirà questo file con kernels in Rust (D1).
//
// vec_add: out[i] = a[i] + b[i], griglia 1-D con guardia sui bordi.
//

.visible .entry vec_add(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u64 out_ptr,
    .param .u32 n
) {
    .reg .pred %p<2>;
    .reg .b32 %r<8>;
    .reg .f32 %f<4>;
    .reg .b64 %rd<12>;

    ld.param.u64  %rd1, [a_ptr];
    ld.param.u64  %rd2, [b_ptr];
    ld.param.u64  %rd3, [out_ptr];
    ld.param.u32  %r1, [n];

    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;

    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mov.u32 %r4, %tid.x;
    mad.lo.s32 %r5, %r2, %r3, %r4;   // i = blockIdx.x * blockDim.x + threadIdx.x

    setp.ge.s32 %p1, %r5, %r1;
    @%p1 bra DONE;

    mul.wide.s32 %rd4, %r5, 4;       // offset = i * sizeof(f32)
    add.s64 %rd5, %rd1, %rd4;
    add.s64 %rd6, %rd2, %rd4;
    add.s64 %rd7, %rd3, %rd4;

    ld.global.f32 %f1, [%rd5];
    ld.global.f32 %f2, [%rd6];
    add.f32 %f3, %f1, %f2;
    st.global.f32 [%rd7], %f3;

DONE:
    ret;
}
